<Window x:Class="LastFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.WindowTitle}"
        Width="688" Height="636"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <!-- Margin so the shadow can be drawn -->
    <Grid x:Name="RootGrid" Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!-- Shadow layer (separate so the content does not get blurred) -->
        <Border CornerRadius="14" Background="{StaticResource WindowBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Card -->
        <Border CornerRadius="14" Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource WindowBorder}" BorderThickness="1"
                Padding="18,14,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="{DynamicResource Str.Header}" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}"
                                Tag="{StaticResource IconMinimize}" ToolTip="{DynamicResource Str.HideTooltip}" Click="HideButton_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Tag="{StaticResource IconClose}" ToolTip="{DynamicResource Str.CloseTooltip}" Click="HideButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ── Search ── -->
                <Border Grid.Row="1" Style="{StaticResource SearchContainer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="2,0,0,0"
                                   Text="{DynamicResource Str.SearchPlaceholder}" FontSize="14.5"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,0,12,0"
                                 Style="{StaticResource SearchTextBox}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- ── Filter buttons: Folder, File + most used extensions ── -->
                <ItemsControl x:Name="FilterChips" Grid.Row="2" Margin="0,12,0,10" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Click="Chip_Click" ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,6,0"
                                             Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{Binding IconGeometry}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── List ── -->
                <Grid Grid.Row="3">
                    <ListBox x:Name="ItemsList"
                             Style="{StaticResource RecentList}"
                             ItemContainerStyle="{StaticResource RowStyle}"
                             MouseDoubleClick="ItemsList_MouseDoubleClick"
                             GotKeyboardFocus="ItemsList_GotKeyboardFocus">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="43">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="74"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding IconImage}" Width="24" Height="24"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900"/>

                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="13.5"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource RowIconButton}" Tag="{StaticResource IconReveal}"
                                                ToolTip="{DynamicResource Str.RevealTooltip}" Click="Reveal_Click"/>
                                        <Button Style="{StaticResource RowIconButton}" Tag="{StaticResource IconCopy}"
                                                ToolTip="{DynamicResource Str.CopyPathTooltip}" Click="CopyPath_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="13.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyText" Text="{DynamicResource Str.NoResults}" FontSize="14"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" IsHitTestVisible="False"/>

                    <!-- Notification (e.g. "Path copied") -->
                    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,8" Padding="14,7" CornerRadius="16"
                            Background="#F02A2C31" BorderBrush="#FF3A3D44" BorderThickness="1"
                            Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
