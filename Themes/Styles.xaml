<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ Typography ═══════════ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ═══════════ Color palette (dark theme matching the mockup exactly) ═══════════ -->
    <SolidColorBrush x:Key="WindowBg" Color="#FA1B1C20"/>
    <SolidColorBrush x:Key="WindowBorder" Color="#FF34363C"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFEDEEF0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9EA1A8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF6F737B"/>

    <SolidColorBrush x:Key="SearchBg" Color="#FF232529"/>
    <SolidColorBrush x:Key="SearchBorder" Color="#FF3A3D44"/>
    <SolidColorBrush x:Key="SearchBorderFocus" Color="#FF4A5568"/>

    <SolidColorBrush x:Key="ChipBg" Color="#FF26282D"/>
    <SolidColorBrush x:Key="ChipBorder" Color="#FF36383E"/>
    <SolidColorBrush x:Key="ChipHover" Color="#FF2F3137"/>
    <SolidColorBrush x:Key="ChipText" Color="#FFB9BCC3"/>
    <SolidColorBrush x:Key="ChipSelectedBg" Color="#FF1F3556"/>
    <SolidColorBrush x:Key="ChipSelectedBorder" Color="#FF2F5185"/>

    <SolidColorBrush x:Key="RowHover" Color="#FF232529"/>
    <SolidColorBrush x:Key="RowSelected" Color="#FF1F3352"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#FF294469"/>

    <SolidColorBrush x:Key="IconButtonHover" Color="#FF2C2E34"/>
    <SolidColorBrush x:Key="Accent" Color="#FF4D8DF7"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════ Icon geometries (24x24) ═══════════ -->
    <Geometry x:Key="IconSearch">M4,10.5 A6.5,6.5 0 1 1 17,10.5 A6.5,6.5 0 1 1 4,10.5 Z M15.3,15.3 L20,20</Geometry>
    <Geometry x:Key="IconClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
    <Geometry x:Key="IconMinimize">M6,12 L18,12</Geometry>
    <Geometry x:Key="IconCopy">M10.5,9 L18.5,9 A1.5,1.5 0 0 1 20,10.5 L20,18.5 A1.5,1.5 0 0 1 18.5,20 L10.5,20 A1.5,1.5 0 0 1 9,18.5 L9,10.5 A1.5,1.5 0 0 1 10.5,9 Z M6,15 L5.5,15 A1.5,1.5 0 0 1 4,13.5 L4,5.5 A1.5,1.5 0 0 1 5.5,4 L13.5,4 A1.5,1.5 0 0 1 15,5.5 L15,6.5</Geometry>
    <Geometry x:Key="IconReveal">M3,7 C3,5.9 3.9,5 5,5 L9.6,5 L11.6,7 L19,7 C20.1,7 21,7.9 21,9 L21,17 C21,18.1 20.1,19 19,19 L5,19 C3.9,19 3,18.1 3,17 Z M10,13 L14.5,13 M12.5,11 L14.5,13 L12.5,15</Geometry>

    <!-- ═══════════ Icon button (header + row actions) ═══════════ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <Viewbox Width="16" Height="16">
                            <Grid Width="24" Height="24">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource IconButtonHover}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Foreground" Value="#FFC3C6CD"/>
    </Style>

    <!-- ═══════════ Search box ═══════════ -->
    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchContainer" TargetType="Border">
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource SearchBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SearchBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SearchBorderFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ Filter buttons (chips) ═══════════ -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ChipText}"/>
        <Setter Property="Background" Value="{StaticResource ChipBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChipBorder}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ChipHover}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource ChipSelectedBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ChipSelectedBorder}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ Thin scrollbar ═══════════ -->
    <Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#FF3A3D44" CornerRadius="3" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF52565F"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF60646D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource InvisibleRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource InvisibleRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ List ═══════════ -->
    <Style x:Key="RecentList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10,0,8,0"/>
        <Setter Property="Margin" Value="0,0,2,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RowSelectedBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row actions: visible only on the selected / hovered row -->
    <Style x:Key="RowActionsPanel" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Hidden"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ToolTip dark theme -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF2A2C31"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="#FF3A3D44"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

</ResourceDictionary>
